# ============================================
# Configuración de Nginx para Sistema RH
# ============================================
# 
# INSTRUCCIONES:
# 1. Copia este archivo a: /etc/nginx/sites-available/rh-system
# 2. Reemplaza todas las rutas y dominios con tus valores reales
# 3. Crea el enlace: sudo ln -s /etc/nginx/sites-available/rh-system /etc/nginx/sites-enabled/
# 4. Verifica: sudo nginx -t
# 5. Reinicia: sudo systemctl restart nginx
#
# ============================================

# OPCIÓN 1: CON SSL/HTTPS (Recomendado)
# ============================================

# Redirección HTTP a HTTPS
server {
    listen 80;
    server_name tu-dominio.com www.tu-dominio.com;
    
    # Redirigir todo a HTTPS
    return 301 https://$server_name$request_uri;
}

# Configuración HTTPS
server {
    listen 443 ssl http2;
    server_name tu-dominio.com www.tu-dominio.com;

    # ============================================
    # CERTIFICADOS SSL (Let's Encrypt)
    # ============================================
    ssl_certificate /etc/letsencrypt/live/tu-dominio.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/tu-dominio.com/privkey.pem;
    
    # Configuración SSL moderna
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # ============================================
    # CONFIGURACIÓN GENERAL
    # ============================================
    client_max_body_size 10M;  # Tamaño máximo de archivos subidos

    # ============================================
    # ARCHIVOS ESTÁTICOS
    # ============================================
    location /static/ {
        alias /ruta/completa/a/tu/proyecto/SistemaRH/staticfiles/;
        expires 30d;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # ============================================
    # ARCHIVOS MEDIA (imágenes subidas por usuarios)
    # ============================================
    location /media/ {
        alias /ruta/completa/a/tu/proyecto/SistemaRH/media/;
        expires 30d;
        add_header Cache-Control "public";
        access_log off;
    }

    # ============================================
    # PROXY A GUNICORN (Django)
    # ============================================
    location / {
        proxy_pass http://unix:/ruta/completa/a/tu/proyecto/SistemaRH/rh-system.sock;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
        
        # Timeouts
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # ============================================
    # LOGS
    # ============================================
    access_log /var/log/nginx/rh-system-access.log;
    error_log /var/log/nginx/rh-system-error.log;
}

# ============================================
# OPCIÓN 2: SIN SSL (Solo HTTP - Temporal)
# ============================================
# Descomenta esto si aún no tienes SSL configurado
# ============================================

